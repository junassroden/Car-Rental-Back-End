# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://127.0.0.1:3000/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=car_rental_db
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated frontend origins allowed to make credentialed API requests
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# Google Identity Services
GOOGLE_CLIENT_ID=

# PayMongo Hosted Checkout, GCash only
PAYMONGO_SECRET_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
PAYMONGO_WEBHOOK_SECRET=

# Django AI service; set the same AI_SERVICE_API_KEY in this app and the AI service
AI_SERVICE_API_URL=http://127.0.0.1:8001/api/chat/
AI_SERVICE_CAPABILITIES_URL=http://127.0.0.1:8001/api/capabilities/
AI_SERVICE_API_KEY=
COMPONENT_CONDITION_VALID_DAYS=90
