# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://127.0.0.1:3000/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=car_rental_db
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated frontend origins allowed to make credentialed API requests
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Django AI service used by POST /api/chat (start it on port 8001: see start-dev.ps1).
# AI_SERVICE_API_KEY must be at least 32 characters and identical in automotive_ai_service/.env.
AI_SERVICE_API_URL=http://127.0.0.1:8001/api/chat/
AI_SERVICE_CAPABILITIES_URL=http://127.0.0.1:8001/api/capabilities/
AI_SERVICE_API_KEY=

# Separate ChatBot service; set the same AI_ROUTER_TOKEN in chatbot/.env
CHATBOT_API_URL=http://127.0.0.1:3001/api/chat
AI_ROUTER_TOKEN=
