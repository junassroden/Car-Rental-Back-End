# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://127.0.0.1:3000/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=car_rental_db
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated frontend origins allowed to make credentialed API requests
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Google AI Studio (Gemini)
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemini-3.8-flash
# Tried in order only when the primary model is unavailable or overloaded
GOOGLE_AI_STUDIO_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite