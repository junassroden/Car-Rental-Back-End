# Copy this file to .env and fill in the values. Never commit .env.
# In production (APP_ENV=production, the default when APP_ENV is unset) the API refuses to start
# while APP_KEY, JWT_SECRET, REFRESH_TOKEN_KEY, FRONTEND_ORIGIN, FRONTEND_URL, XENDIT_SECRET_KEY,
# XENDIT_CALLBACK_TOKEN, AI_SERVICE_API_KEY, MAIL_FROM_ADDRESS, DB_NAME or DB_USER is missing.

# Application Settings
APP_NAME=DriveRent
# Random secret for session signing and encryption: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# development shows PHP errors; production hides them. Use production on any public server.
APP_ENV=development
APP_URL=http://127.0.0.1:3000/
# 1 = log errors and exceptions to runtime/logs/log.txt (default), 0 = off, 2 = debug, 3 = all
LOG_THRESHOLD=1

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=car_rental_db
DB_CHARSET=utf8mb4
DB_PREFIX=
# Set to true only while running `php lava migration run`
MIGRATION_ENABLED=false

# For API: two different random values of at least 32 characters each
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Token issuer and audience claims (changing them signs everyone out once)
JWT_ISSUER=driverent-api
JWT_AUDIENCE=driverent-web

# Comma-separated frontend origins allowed to make credentialed API requests
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Base URL used in payment redirects and in email verification / password reset links
FRONTEND_URL=http://127.0.0.1:5173

# Account emails (verification, password reset), sent with PHP mail().
# PHP's sendmail_path (or SMTP settings on Windows) must point at a working mail transport.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DriveRent

# Google Identity Services
GOOGLE_CLIENT_ID=

# Xendit Invoice API (online payment). The callback token is set in the Xendit dashboard and
# authenticates POST /api/xendit/webhook.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Django AI service used by POST /api/chat. Start it from automotive_ai_service with:
#   venv\Scripts\python manage.py runserver 127.0.0.1:8001
# AI_SERVICE_API_KEY must be at least 32 characters and identical in automotive_ai_service/.env.
AI_SERVICE_API_URL=http://127.0.0.1:8001/api/chat/
AI_SERVICE_CAPABILITIES_URL=http://127.0.0.1:8001/api/capabilities/
AI_SERVICE_API_KEY=
COMPONENT_CONDITION_VALID_DAYS=90
